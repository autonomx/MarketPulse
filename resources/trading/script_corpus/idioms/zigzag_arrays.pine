//@version=5
indicator("ZigZag with arrays (idiom)", overlay=true, max_lines_count=100)
depth = input.int(5, "Pivot depth", minval=1)
maxLines = input.int(20, "Lines kept", minval=1)
var pivots = array.new_float()
var indices = array.new_int()
var lines = array.new_line()
ph = ta.pivothigh(depth, depth)
pl = ta.pivotlow(depth, depth)
addPivot(price, index) =>
    if array.size(pivots) > 0
        prevPrice = array.get(pivots, array.size(pivots) - 1)
        prevIndex = array.get(indices, array.size(indices) - 1)
        array.push(lines, line.new(prevIndex, prevPrice, index, price, color=color.orange, width=2))
    array.push(pivots, price)
    array.push(indices, index)
    if array.size(lines) > maxLines
        line.delete(array.shift(lines))
    if array.size(pivots) > maxLines + 1
        array.shift(pivots)
        array.shift(indices)
if not na(ph)
    addPivot(ph, bar_index - depth)
if not na(pl)
    addPivot(pl, bar_index - depth)
float total = 0.0
for i = 0 to array.size(pivots) - 1 by 1
    if array.size(pivots) == 0
        break
    total += array.get(pivots, i)
plot(array.size(pivots) > 0 ? total / array.size(pivots) : na, "Average pivot", color=color.gray)
if barstate.islast and array.size(pivots) > 0
    label.new(bar_index, close, str.format("{0} pivots, last {1,number,#.##}", array.size(pivots), array.get(pivots, -1)))
